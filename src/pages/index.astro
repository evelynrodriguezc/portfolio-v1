---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Evelyn R. — Developer">

  <!-- Hero -->
  <section id="hero">
    <div class="hero-top">
      <span class="hero-name">Evelyn Rodríguez</span>
      <span class="hero-status">Portfolio 2026</span>
    </div>
    <h1 class="reveal"><span class="reveal-item"><span class="h1-full">Web developer<br />who keeps real sites<br /><span class="accent-word">running</span> and<br />ships new ones</span><span class="h1-short">Web developer who ships <span class="accent-word">real</span> sites</span></span></h1>
    <p class="hero-sub reveal">
      <span class="reveal-item" style="--reveal-delay: 0.12s"><span class="sub-full">Building websites and web applications with HTML, CSS, JavaScript, and React. Experienced in WordPress development, frontend engineering, and workflow automation.</span><span class="sub-short">Building reliable websites<br />and web applications.</span></span>
    </p>
    <div class="hero-actions reveal">
      <a href="#projects" class="hero-cta-primary reveal-item" style="--reveal-delay: 0.2s">Explore selected work <span class="arrow arrow-down">↓</span></a>
      <span class="hero-availability reveal-item" style="--reveal-delay: 0.26s"><span class="status-dot"></span>Open to opportunities · <a href="#contact" class="hero-cta-secondary">Contact me <span class="arrow">→</span></a></span>
    </div>
    <div class="hero-proof reveal">
      <div class="proof-item reveal-item" style="--reveal-delay: 0.32s">
        <span class="proof-num">70+</span>
        <span class="proof-label">production websites</span>
      </div>
      <div class="proof-item reveal-item" style="--reveal-delay: 0.38s">
        <span class="proof-num">4+ yrs</span>
        <span class="proof-label">remote experience</span>
      </div>
    </div>
  </section>

  <!-- Interstitial -->
  <div class="interstitial">
    <p class="scroll-reveal"><span class="hide-mobile">Not every project starts from scratch. Most require understanding, improving, and maintaining <span class="accent-word">existing systems</span>.</span><span class="show-mobile">Real projects evolve. That's where I enjoy <span class="accent-word">building</span>.</span></p>
  </div>

  <!-- Projects -->
  <section id="projects">
    <div class="section-side">
      <span class="section-num">01</span>
      <span class="section-name">featured</span>
    </div>
    <div class="section-content">

    <div class="showcase">

      <article class="showcase-card showcase-card--wide scroll-reveal">
        <a href="https://nova.evelynr.dev" target="_blank" rel="noopener" class="showcase-media">
          <img src="/nova_ss.png" alt="Nova project management dashboard" loading="lazy" />
        </a>
        <div class="showcase-info">
          <div class="showcase-text">
            <h3>Nova</h3>
            <p>A working preview of an AI-assisted project management app. React interface end to end: project views, team dashboard, AI-insight panels.</p>
          </div>
          <div class="showcase-meta">
            <div class="showcase-tags">
              <span>React</span><span>Node.js</span><span>PostgreSQL</span>
            </div>
            <a href="https://nova.evelynr.dev" target="_blank" rel="noopener" class="showcase-link">View live ↗</a>
          </div>
        </div>
      </article>

      <article class="showcase-card scroll-reveal" style="--reveal-delay: 0.08s">
        <a href="https://smart-home-solutions.evelynr.dev" target="_blank" rel="noopener" class="showcase-media">
          <img src="/smart-homes-s-ss.png" alt="SmartHome product site" loading="lazy" />
        </a>
        <div class="showcase-info">
          <div class="showcase-text">
            <h3>SmartHome</h3>
            <p>Product site for a home automation platform. Responsive multi-page build: Bootstrap, HTML, vanilla JavaScript.</p>
          </div>
          <div class="showcase-meta">
            <div class="showcase-tags">
              <span>Bootstrap</span><span>JavaScript</span><span>HTML</span>
            </div>
            <a href="https://smart-home-solutions.evelynr.dev" target="_blank" rel="noopener" class="showcase-link">View live ↗</a>
          </div>
        </div>
      </article>

      <article class="showcase-card scroll-reveal" style="--reveal-delay: 0.16s">
        <a href="https://equestria.evelynr.dev" target="_blank" rel="noopener" class="showcase-media">
          <img src="/horses-ss.png" alt="Equestrian business website" loading="lazy" />
        </a>
        <div class="showcase-info">
          <div class="showcase-text">
            <h3>Equestrian Website</h3>
            <p>Informational site for an equestrian business. Multi-page responsive layout: Bootstrap, HTML, CSS.</p>
          </div>
          <div class="showcase-meta">
            <div class="showcase-tags">
              <span>Bootstrap</span><span>HTML</span><span>CSS</span>
            </div>
            <a href="https://equestria.evelynr.dev" target="_blank" rel="noopener" class="showcase-link">View live ↗</a>
          </div>
        </div>
      </article>

    </div>
    </div>
  </section>

  <!-- Interstitial: featured → client work -->
  <div class="interstitial interstitial--left">
    <p class="scroll-reveal"><span class="hide-mobile">Side projects show range. Client work shows <span class="accent-word">what ships</span>.</span><span class="show-mobile">Side projects inspire. Client work <span class="accent-word">ships</span>.</span></p>
  </div>

  <!-- Selected Work -->
  <section id="work">
    <div class="section-side">
      <span class="section-num">02</span>
      <span class="section-name">client work</span>
    </div>
    <div class="section-content">

    <div class="showcase">

      <article class="showcase-card scroll-reveal">
        <a href="/work/delmain" class="showcase-media">
          <img src="/delmain1.png" alt="Jackson Family Dental website" loading="lazy" />
        </a>
        <div class="showcase-info">
          <div class="showcase-text">
            <p class="showcase-agency">Delmain</p>
            <h3>Jackson Family Dental</h3>
            <p>Frontend implementation and responsive improvements for a production business website.</p>
          </div>
          <div class="showcase-meta">
            <div class="showcase-tags">
              <span>WordPress</span><span>PHP</span><span>CSS</span><span>JavaScript</span>
            </div>
            <a href="https://jacksonfamilydentalonline.com/" target="_blank" rel="noopener" class="showcase-link">Live site ↗</a>
            <a href="/work/delmain" class="showcase-link showcase-link--dim">Case study →</a>
          </div>
        </div>
      </article>

      <article class="showcase-card scroll-reveal" style="--reveal-delay: 0.1s">
        <a href="/work/simply-heating" class="showcase-media">
          <img src="/pekan1.png" alt="Simply Heating website" loading="lazy" />
        </a>
        <div class="showcase-info">
          <div class="showcase-text">
            <p class="showcase-agency">Pekan Designs</p>
            <h3>Simply Heating</h3>
            <p>Built from scratch from a Figma design: responsive implementation and ongoing maintenance.</p>
          </div>
          <div class="showcase-meta">
            <div class="showcase-tags">
              <span>HTML</span><span>CSS</span><span>JavaScript</span>
            </div>
            <a href="https://simplyheating.ca" target="_blank" rel="noopener" class="showcase-link">Live site ↗</a>
            <a href="/work/simply-heating" class="showcase-link showcase-link--dim">Case study →</a>
          </div>
        </div>
      </article>

    </div>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <div class="section-side">
      <span class="section-num">03</span>
      <span class="section-name">how i work</span>
    </div>
    <div class="section-content">
    <p class="about-text scroll-reveal">
      I enjoy building software that people actually use. I focus on creating interfaces that are clear, responsive, and built to last. Good frontend engineering is about building products that stay reliable and easy to maintain.
    </p>
    <ul class="about-facts scroll-reveal" style="--reveal-delay: 0.1s">
      <li>HTML · CSS · JavaScript · React · WordPress</li>
      <li>70+ production sites maintained &amp; extended (agency, 2024–2025)</li>
      <li class="fact-extra">Workflow automation: publishing, QA, SMTP/forms</li>
      <li>Systems Engineering degree</li>
      <li>English C1 / Spanish native</li>
      <li class="fact-extra">Remote, international clients</li>
    </ul>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact">
    <div class="section-side">
      <span class="section-num">04</span>
      <span class="section-name">contact</span>
    </div>
    <div class="section-content">
    <h2 class="contact-heading scroll-reveal">Let's work <span class="accent-word">together</span>.</h2>
    <p class="contact-sub scroll-reveal" style="--reveal-delay: 0.08s">Available for remote work, contract or full-time: frontend, WordPress, workflow automation.</p>
    <div class="contact-links-row scroll-reveal" style="--reveal-delay: 0.14s">
      <a href="#contact" class="contact-icon-link" id="email-link" aria-label="Email">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="1.5" y="4" width="21" height="16" rx="2.2"/>
          <path d="m1.5 6 10.5 7 10.5-7"/>
        </svg>
      </a>
      <a href="https://github.com/evelynrodriguezc" target="_blank" rel="noopener" class="contact-icon-link" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.69-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.43-2.69 5.4-5.25 5.69.41.35.78 1.05.78 2.11v3.13c0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/evelynrodriguezc0" target="_blank" rel="noopener" class="contact-icon-link" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.77-.77 1.77-1.73V1.72C24 .77 23.21 0 22.22 0z"/>
        </svg>
      </a>
    </div>
    <div class="footer-bar">
      <span>© 2026 Evelyn Rodríguez</span>
      <a href="#hero" class="back-top">Back to top ↑</a>
    </div>
    </div>
  </section>

</MainLayout>

<script>
  const user = ['evelyn', 'rodriguez', 'c0'].join('');
  const domain = ['gmail', 'com'].join('.');
  const link = document.getElementById('email-link') as HTMLAnchorElement;
  link.href = `mailto:${user}@${domain}`;

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const target = document.querySelector(anchor.getAttribute('href') ?? '');
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView();
      history.replaceState(null, '', window.location.pathname);
    });
  });

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.proof-num').forEach((el) => {
      const match = (el.textContent ?? '').match(/^(\d+)(.*)$/);
      if (!match) return;
      const target = parseInt(match[1], 10);
      const suffix = match[2];
      const start = performance.now();
      const duration = 1000;
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(target * eased) + suffix;
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }
</script>
