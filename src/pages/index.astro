            <a href="/work/simply-heating" class="showcase-link showcase-link--dim">Case study →</a>
          </div>
        </div>
      </article>

    </div>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <div class="section-side">
      <span class="section-num">03</span>
      <span class="section-name">how i work</span>
    </div>
    <div class="section-content">
    <p class="about-text">
      I enjoy building software that people actually use. I focus on creating interfaces that are clear, responsive, and built to last. Good frontend engineering is about building products that stay reliable and easy to maintain.
    </p>
    <ul class="about-facts">
      <li>HTML · CSS · JavaScript · React · WordPress</li>
      <li>70+ production sites maintained &amp; extended (agency, 2024–2025)</li>
      <li class="fact-extra">Workflow automation: publishing, QA, SMTP/forms</li>
      <li>Systems Engineering degree</li>
      <li>English C1 / Spanish native</li>
      <li class="fact-extra">Remote, international clients</li>
    </ul>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact">
    <div class="section-side">
      <span class="section-num">04</span>
      <span class="section-name">contact</span>
    </div>
    <div class="section-content">
    <h2 class="contact-heading">Let's work <span class="accent-word">together</span>.</h2>
    <p class="contact-sub">Available for remote work, contract or full-time: frontend, WordPress, workflow automation.</p>
    <div class="contact-links-row">
      <a href="#contact" class="contact-link-item" id="email-link">Email <span class="arrow">→</span></a>
      <a href="https://github.com/evelynrodriguezc" target="_blank" rel="noopener" class="contact-link-item">GitHub <span class="arrow arrow-out">↗</span></a>
      <a href="https://www.linkedin.com/in/evelynrodriguezc0" target="_blank" rel="noopener" class="contact-link-item">LinkedIn <span class="arrow arrow-out">↗</span></a>
    </div>
    <div class="footer-bar">
      <span>© 2026 Evelyn Rodríguez</span>
      <a href="#hero" class="back-top">Back to top ↑</a>
    </div>
    </div>
  </section>

</MainLayout>

<script>
  const user = ['evelyn', 'rodriguez', 'c0'].join('');
  const domain = ['gmail', 'com'].join('.');
  const link = document.getElementById('email-link') as HTMLAnchorElement;
  link.href = `mailto:${user}@${domain}`;

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const target = document.querySelector(anchor.getAttribute('href') ?? '');
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView();
      history.replaceState(null, '', window.location.pathname);
    });
  });

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.proof-num').forEach((el) => {
      const match = (el.textContent ?? '').match(/^(\d+)(.*)$/);
      if (!match) return;
      const target = parseInt(match[1], 10);
      const suffix = match[2];
      const start = performance.now();
      const duration = 1000;
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(target * eased) + suffix;
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }
</script>
