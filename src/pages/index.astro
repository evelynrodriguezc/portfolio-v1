---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Evelyn Rodriguez — Software Engineer">

  <!-- Hero -->
  <section id="hero">
    <p class="eyebrow">Evelyn Rodriguez — Software Engineer</p>
    <h1>Building software that is<br class="br-desktop" /> clear, useful, and well-made.</h1>
    <p class="hero-sub">
      Systems engineer focused on frontend development, AI tooling,
      and shipping things that work.
    </p>
    <div class="hero-actions">
      <a href="#projects" class="btn btn-primary">View Work</a>
      <a href="#contact" class="btn btn-ghost">Get in Touch</a>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects">
    <div class="projects-header">
      <p class="section-label">Projects</p>
      <p class="projects-subtitle">Frontend experiments and product-focused projects.</p>
    </div>

    <div class="projects-grid">

      <article class="project-card">
        <div class="project-img-wrap">
          <a href="https://nova.evelynr.dev" target="_blank" rel="noopener">
            <img src="/nova_ss.png" alt="Nova app screenshot" />
          </a>
        </div>
        <div class="project-body">
          <div class="project-meta">
            <h3>Nova</h3>
            <div class="project-tags">
              <span>React</span>
              <span>Node.js</span>
              <span>PostgreSQL</span>
            </div>
          </div>
          <p class="project-desc">AI-powered project management SaaS concept. A frontend prototype exploring how AI insights could surface team bottlenecks and automate workload distribution.</p>
          <a href="https://nova.evelynr.dev" target="_blank" rel="noopener" class="project-link">View Project →</a>
        </div>
      </article>

      <article class="project-card">
        <div class="project-img-wrap">
          <a href="https://smart-home-solutions.evelynr.dev" target="_blank" rel="noopener">
            <img src="/smart-homes-s-ss.png" alt="SmartHome dashboard screenshot" />
          </a>
        </div>
        <div class="project-body">
          <div class="project-meta">
            <h3>SmartHome</h3>
            <div class="project-tags">
              <span>Bootstrap</span>
              <span>JavaScript</span>
              <span>HTML</span>
            </div>
          </div>
          <p class="project-desc">A home automation platform for controlling lights, blinds, appliances, security cameras, and energy usage from a single interface.</p>
          <a href="https://smart-home-solutions.evelynr.dev" target="_blank" rel="noopener" class="project-link">View Project →</a>
        </div>
      </article>

      <article class="project-card">
        <div class="project-img-wrap">
          <a href="https://equestria.evelynr.dev" target="_blank" rel="noopener">
            <img src="/horses-ss.png" alt="Equestrian website screenshot" />
          </a>
        </div>
        <div class="project-body">
          <div class="project-meta">
            <h3>Equestrian Website</h3>
            <div class="project-tags">
              <span>Bootstrap</span>
              <span>HTML</span>
              <span>CSS</span>
            </div>
          </div>
          <p class="project-desc">An informational website for an equestrian business, designed for clarity and easy navigation across services, horses, and contact info.</p>
          <a href="https://equestria.evelynr.dev" target="_blank" rel="noopener" class="project-link">View Project →</a>
        </div>
      </article>

      <article class="project-card">
        <div class="project-img-wrap">
          <a href="https://www.figma.com/design/DLYUOd8T1ibHGOMPutyryY/NotesAppDesign?node-id=2103-685&t=Uu1i5inqXQfHwnkq-1" target="_blank" rel="noopener">
            <img src="/figma-ss.png" alt="Notes app screenshot" />
          </a>
        </div>
        <div class="project-body">
          <div class="project-meta">
            <h3>Notes App</h3>
            <div class="project-tags">
              <span>Figma</span>
              <span>UI Design</span>
            </div>
          </div>
          <p class="project-desc">An iOS notes app designed in Figma — includes list and detail views, image support, quote formatting, and interactive bottom sheets for sharing and deleting.</p>
          <a href="https://www.figma.com/design/DLYUOd8T1ibHGOMPutyryY/NotesAppDesign?node-id=2103-685&t=Uu1i5inqXQfHwnkq-1" target="_blank" rel="noopener" class="project-link">View Project →</a>
        </div>
      </article>

    </div>
  </section>

  <!-- Selected Work -->
  <section id="work">
    <p class="section-label">Selected Work</p>

    <div class="work-list">

      <article class="work-item">
        <div class="work-info">
          <h3>Delmain</h3>
          <span class="work-tag">WordPress · Web Development</span>
        </div>
        <p class="work-desc">
          Built and maintained ~70 WordPress websites for small businesses.
          Implemented automation for form handling and content workflows to reduce
          manual overhead and improve team efficiency.
        </p>
        <a href="javascript:void(0);" class="work-link">View Details →</a>
      </article>

      <article class="work-item">
        <div class="work-info">
          <h3>Outlier AI</h3>
          <span class="work-tag">AI · Evaluation</span>
        </div>
        <p class="work-desc">
          Evaluated AI-generated outputs across coding and multimodal tasks.
          Identified patterns and improved response quality through structured
          analysis and feedback workflows.
        </p>
        <a href="javascript:void(0);" class="work-link">View Details →</a>
      </article>

      <article class="work-item">
        <div class="work-info">
          <h3>Portfolio Website</h3>
          <span class="work-tag">Astro · Design</span>
        </div>
        <p class="work-desc">
          Designed and built this portfolio using Astro, focused on clean layout,
          responsive design, and fast load times. Deployed on Vercel with a custom domain.
        </p>
        <a href="javascript:void(0);" class="work-link">View Details →</a>
      </article>

    </div>
  </section>

  <!-- Contact -->
  <section id="contact">
    <h2>Get in Touch</h2>
    <p>Open to new opportunities and interesting projects.</p>
    <div class="contact-links">
      <a href="mailto:evelynrodriguezc0@gmail.com">evelynrodriguezc0@gmail.com</a>
      <a href="https://github.com/evelynrodriguezc" target="_blank" rel="noopener">GitHub</a>
    </div>
  </section>

</MainLayout>
